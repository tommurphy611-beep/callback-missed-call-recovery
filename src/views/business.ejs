<!doctype html><html><head><title><%=b.name%> · CallBack</title><link rel="stylesheet" href="/app.css"></head><body><header><a href="/">CallBack</a><span><%=b.name%></span></header><main><div class="hero"><div><small class="badge"><%=b.demo?'DEMO CLIENT · ':''%><%=b.setupStatus%></small><h1><%=b.name%></h1><p><%=b.mode==='TWILIO_FORWARD'?'Mode A: Twilio number forwards to owner':'Mode B: carrier conditional-forwarding' %> · Automation <%=b.automationEnabled?'enabled':'disabled'%></p></div><a class="button" href="tel:<%=b.callbackPhone||b.phone%>">Call business</a></div><section class="notice"><b>Setup wizard:</b> 1 details ✓ · 2 mode ✓ · 3 add compatible numbers · 4 verify template/reply mechanism · 5 configure webhooks below · 6–8 run live test · 9 activate. Mode B can miss abandoned calls and may not preserve caller ID; never activate without confirming carrier behaviour.</section><section class="grid two"><div class="card"><h2>Numbers</h2><%b.numbers.forEach(n=>{%><p><b><%=n.purpose%></b> <%=n.number%> — voice:<%=n.voice%>, SMS:<%=n.sms%>, two-way:<%=n.twoWay%></p><%})%><form method="post" action="/businesses/<%=b.id%>/numbers"><input type="hidden" name="_csrf" value="<%=csrf%>"><input name="number" placeholder="+353..." required><select name="purpose"><option>VOICE</option><option>SMS</option></select><label><input type="checkbox" name="voice" value="true">Voice</label><label><input type="checkbox" name="sms" value="true">SMS</label><label><input type="checkbox" name="twoWay" value="true">Two-way</label><button>Add number</button></form></div><div class="card"><h2>Twilio configuration</h2><p>Voice webhook: <code><%=typeof process.env?.APP_URL !== 'undefined' ? process.env.APP_URL : 'APP_URL'%>/webhooks/voice</code></p><p>Messaging webhook: <code>APP_URL/webhooks/sms</code></p><p>Status callback: <code>APP_URL/webhooks/status</code></p><p>Use a two-way SMS number for replies. Alphanumeric sender IDs are one-way; use a secure enquiry form instead.</p></div></section><%if(b.demo){%><form method="post" action="/businesses/<%=b.id%>/demo"><input name="_csrf" value="<%=csrf%>" type="hidden"><button>Run SIMULATED missed call</button></form><%}%><section><h2>Enquiry inbox</h2><%enquiries.forEach(e=>{%><article class="card"><b><%=e.caller||'Caller ID unavailable'%></b> · <%=e.status%> · <%=e.replyReceived?'Reply received':''%><a href="tel:<%=e.caller%>">Call back</a><p><%=e.messages.map(m=>`${m.direction}: ${m.body} (${m.status})`).join(' · ')||'No messages yet'%></p><form method="post" action="/enquiries/<%=e.id%>/status"><input name="_csrf" value="<%=csrf%>" type="hidden"><select name="status"><%['NEW','CONTACTED','BOOKED','CLOSED','INVALID'].forEach(s=>{%><option <%=e.status===s?'selected':''%>><%=s%></option><%})%></select><input name="notes" value="<%=e.notes%>" placeholder="Notes"><button>Save</button></form></article><%})%></section><section class="grid two"><div><h2>Calls</h2><%calls.forEach(c=>{%><p class="card"><%=c.simulated?'SIMULATED ':''%><%=c.from||'No caller ID'%> · <%=c.outcome%></p><%})%></div><div><h2>Messages</h2><%msgs.forEach(m=>{%><p class="card"><%=m.simulated?'SIMULATED ':''%><%=m.direction%> · <%=m.status%></p><%})%></div></section></main></body></html>
