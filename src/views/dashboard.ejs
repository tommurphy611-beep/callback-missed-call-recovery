<!doctype html><html><head><title>CallBack</title><link rel="stylesheet" href="/app.css"></head><body><header><b>CallBack</b><span>Missed-call recovery</span><form method="post" action="/logout"><input name="_csrf" value="<%=csrf%>" type="hidden"><button>Log out</button></form></header><main><div class="hero"><div><h1>Businesses</h1><p>Live production data is separate from demo activity.</p></div><%if(user.role==='OPERATOR'){%><a class="button" href="/businesses/new">Add client</a><%}%></div><section class="grid"><% businesses.forEach(b=>{%><a class="card link" href="/businesses/<%=b.id%>"><small><%=b.setupStatus%> · <%=b.demo?'DEMO':''%></small><h2><%=b.name%></h2><p><%=b.trade%> · <%=b.phone%></p><p><b><%=b._count.calls%></b> calls · <b><%=b._count.enquiries%></b> enquiries</p></a><%})%></section></main></body></html>
